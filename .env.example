# Required for AI-authored acquisition plans.
# Without it the app still runs: the deterministic engine produces the full
# scorecard, red flags, checklist and seller questions, and the narrative
# sections fall back to templated prose.
ANTHROPIC_API_KEY=sk-ant-...

# Model used to author acquisition plans.
ANTHROPIC_MODEL=claude-opus-5

# Passphrase gating /portfolio (the private acquisition dashboard).
# Leave unset in local dev to leave the dashboard open.
PORTFOLIO_PASSPHRASE=

# Directory for the JSON-backed portfolio store.
DATA_DIR=.data
