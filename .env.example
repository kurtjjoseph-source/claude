# Required in production: signs session cookies. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute URL of the deployed site, used to build invitation links.
SITE_URL=https://example.netlify.app

# Invitation email. Without these the invitation is still created and the admin
# screen shows a link to pass on by hand.
RESEND_API_KEY=
MAIL_FROM="Exhorter Studie <studie@example.org>"

# Directory for the JSON store in local development. On Netlify the store uses
# Netlify Blobs instead and this is ignored.
DATA_DIR=.data
